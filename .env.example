# Copy to .env.local (ignored by git) for local development, and add the same two
# variables in Vercel: Project Settings -> Environment Variables. Then redeploy.
# Both values are in Supabase: Project Settings -> API.
# The anon key is meant to be public; the database rules in supabase/setup.sql protect the data.
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
